// 从该领域题库的 KE 标注抽取的 CO 声明。

// @usage 1
concept Equation;

// @usage 5
concept Integer <: Number;

// @usage 3
concept Integer;

// @usage 1
concept NaturalNumber <: Number;

// @usage 6
concept NaturalNumber;

// @usage 2
concept NumberList;

// @usage 1
concept PositiveInteger <: Number;

// @usage 3
concept PositiveInteger;

// @usage 1
concept PrimeNumber <: Number;

// @usage 2
concept Term;

// @usage 9
op count(arg1 : set(Concept)) : Number;

// @usage 1
op frac_sum(arg1 : PositiveInteger) : Number;

// @usage 2
op gcd(arg1 : NaturalNumber, arg2 : NaturalNumber) : NaturalNumber;

// @usage 2
op get_per_num(arg1 : Number) : NumberList;

// @usage 1
op is_coprime(arg1 : Number, arg2 : Number) : Bool;


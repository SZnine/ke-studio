// @usage 1
op is_prime(arg1 : NaturalNumber) : Bool;

// @usage 1
op is_prime(arg1 : Number) : Bool;

// @usage 1
op is_solution(arg1 : Equation, arg2 : set(Number)) : Bool;

// @usage 1
op list_square(arg1 : Term) : Number;


{
  "name": "ke-studio",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Local-first KE language and ontology workbench",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "template": "node scripts/template.mjs",
    "preview": "node scripts/serve.mjs",
    "test:site": "node --test test/site-build.test.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@noble/hashes": "1.8.0",
    "katex": "0.16.47",
    "langium": "4.1.3",
    "monaco-editor": "0.57.0",
    "pinyin-pro": "3.29.5",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "vscode-languageserver-textdocument": "1.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/wicg-file-system-access": "^2023.10.6",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",

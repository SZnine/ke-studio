{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "wicg-file-system-access"
    ]
  },
  "include": [
    "src/**/*.ts",
    "web/**/*.ts",
    "studio/language/**/*.ts",
    "test/**/*.ts"
  ]
}
